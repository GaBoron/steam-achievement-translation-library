  "achievements": {
    "ON_THE_FIRST_DAY": {
      "translations": {
        "english": {
          "name": "On the First Day I Built an Army",
          "description": "Recruit 8 archers on the first day."
        },
        "schinese": {
          "name": "第一天我拉起了军队",
          "description": "在第一天招募8名弓箭手。"
        }
      }
    },
    "ON_THE_SECOND_DAY": {
      "translations": {
        "english": {
          "name": " On the Second Day I Got a Gift",
          "description": "Get free walls on the second day."
        },
        "schinese": {
          "name": "第二天我收到了礼物",
          "description": "在第二天获得免费的城墙。"
        }
      }
    },
    "ON_THE_THIRD_DAY": {
      "translations": {
        "english": {
          "name": "On the Third Day I Lit a Fire",
          "description": "Do not start your camp until day 3."
        },
        "schinese": {
          "name": "第三天我点起了篝火",
          "description": "在第3天之前不要开始建立营地。"
        }
      }
    },
    "ON_THE_FOURTH_DAY": {
      "translations": {
        "english": {
          "name": "On the Fourth Day We Had a Feast",
          "description": "Hunt 20 deer before the end of day four."
        },
        "schinese": {
          "name": "第四天我们摆下盛宴",
          "description": "在第四天结束前猎获20只鹿。"
        }
      }
    },
    "FOR_FIVE_DAYS": {
      "translations": {
        "english": {
          "name": "For Five Days I Turned the Other Cheek",
          "description": "Kill nothing until day six."
        },
        "schinese": {
          "name": "连续五天打不还手",
          "description": "在第六天到来之前不杀任何东西。"
        }
      }
    },
    "BY_DAY_SIXTH": {
      "translations": {
        "english": {
          "name": "By Day Six I Was Rich",
          "description": "Have more gold than you can carry by day six."
        },
        "schinese": {
          "name": "第六天我已富甲一方",
          "description": "在第六天时金币多到超出携带上限。"
        }
      }
    },
    "ON_THE_EIGTH_DAY": {
      "translations": {
        "english": {
          "name": "On the Eighth Day I Fumbled",
          "description": "A nimble ruler will never let his money touch the ground."
        },
        "schinese": {
          "name": "第八天我失了手",
          "description": "手脚麻利的君主绝不会让金币落地。"
        }
      }
    },
    "ON_THE_NINTH_DAY": {
      "translations": {
        "english": {
          "name": "On the Ninth Day I First Ran",
          "description": "Do not let your steed run away before this day."
        },
        "schinese": {
          "name": "第九天我初次疾驰",
          "description": "在这天之前不要让坐骑跑丢。"
        }
      }
    },
    "THE_TENTH_DAY": {
      "translations": {
        "english": {
          "name": "The Tenth Day We Fought Back",
          "description": "Destroy by this day from whence they came!"
        },
        "schinese": {
          "name": "第十天我们绝地反击",
          "description": "在这一天之前摧毁它们的来处！"
        }
      }
    },
    "SURVIVED_UNTIL_DAY_5": {
      "translations": {
        "english": {
          "name": "Day V",
          "description": "Survive past day 5. "
        },
        "schinese": {
